{
  "name": "Biexponential",
  "description": "Performs a bi-exponential transformation of your data.",
  "tags": [
    "flow cytometry",
    "preprocessing",
    "transformation"
  ],
  "authors": [
    "tercen"
  ],
  "urls": [
    "https://github.com/tercen/biexponential_operator"
  ],
  "properties": [
    {
      "kind": "DoubleProperty",
      "name": "a",
      "defaultValue": 0.5,
      "description": "See the function description in the operator documentation. Defaults to 0.5."
    },
    {
      "kind": "DoubleProperty",
      "name": "b",
      "defaultValue": 1.0,
      "description": "See the function description in the operator documentation. Defaults to 1.0."
    },
    {
      "kind": "DoubleProperty",
      "name": "c",
      "defaultValue": 0.5,
      "description": "See the function description in the operator documentation. Defaults to 0.5."
    },
    {
      "kind": "DoubleProperty",
      "name": "d",
      "defaultValue": 1.0,
      "description": "See the function description in the operator documentation. Defaults to 1.0."
    },
    {
      "kind": "DoubleProperty",
      "name": "f",
      "defaultValue": 0,
      "description": "Offset for the intercept. Defaults to 0."
    },
    {
      "kind": "DoubleProperty",
      "name": "w",
      "defaultValue": 0,
      "description": "A constant bias for the 0 point of the data. Defaults to 0."
    }
  ],
  "operatorSpec": {
    "kind": "OperatorSpec",
    "ontologyUri": "https://tercen.com/_ontology/tercen",
    "ontologyVersion": "0.0.1",
    "inputSpecs": [
      {
        "kind": "CrosstabSpec",
        "metaFactors": [
          {
            "kind": "MetaFactor",
            "name": "Row",
            "type": "",
            "description": "Optional row factor",
            "ontologyMapping": "variable",
            "crosstabMapping": "row",
            "cardinality": "0..n",
            "factors": []
          },
          {
            "kind": "MetaFactor",
            "name": "Column",
            "type": "",
            "description": "Optional column factor",
            "ontologyMapping": "observation",
            "crosstabMapping": "column",
            "cardinality": "0..n",
            "factors": []
          }
        ],
        "axis": [
          {
            "kind": "AxisSpec",
            "metaFactors": [
              {
                "kind": "MetaFactor",
                "name": "Measurement",
                "type": "double",
                "description": "Input data, per cell",
                "ontologyMapping": "measurement",
                "crosstabMapping": "y",
                "cardinality": "1",
                "factors": []
              }
            ]
          }
        ]
      }
    ],
    "outputSpecsV2": [
      {
        "kind": "OperatorJoinSpec",
        "joinOperators": [
          {
            "kind": "JoinOperator",
            "joinType": "left",
            "leftPair": {
              "kind": "ColumnPair",
              "lColumns": [
                "Row",
                "Column"
              ],
              "rColumns": [
                "Row",
                "Column"
              ]
            },
            "rightRelation": {
              "kind": "TableRelation",
              "attributes": [
                {
                  "kind": "Attribute",
                  "name": "value",
                  "type": "double"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}